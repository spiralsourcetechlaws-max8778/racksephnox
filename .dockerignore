# ═══════════════════════════════════════════════════════════════
#  RACKSEPHNOX · Docker Build Ignore
# ═══════════════════════════════════════════════════════════════

# Version control
.git
.gitignore
.gitattributes

# CI/CD
.github/

# Dependencies (rebuilt inside container)
node_modules
vendor

# Environment secrets
.env
.env.*
!.env.example

# Storage & cache
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!storage/.gitkeep
!bootstrap/cache/.gitkeep

# Database (rebuild via migrations)
database/*.sqlite
database/*.sqlite-*
database/*.db

# Build artifacts (rebuilt inside container)
public/build
public/hot
public/storage

# IDE & editors
.idea
.vscode
.fleet
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Testing & coverage
tests/
phpunit.xml
.phpunit.cache/
coverage/

# Documentation
docs/
*.md
!README.md

# Legacy backups
*.bak
*.backup
*.old
backup_migrations/

# Docker files
Dockerfile
.dockerignore
docker-compose*.yml

# Local scripts
scripts/local-*.sh
setup-local.sh

# Misc
*.log
.fly.toml
railway.json
