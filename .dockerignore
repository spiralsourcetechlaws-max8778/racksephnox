# ─── Version control ───
.git
.gitignore
.gitattributes
.github/

# ─── Dependencies (rebuilt inside container) ───
node_modules
vendor
composer.lock
package-lock.json
yarn.lock

# ─── Environment & secrets ───
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ─── Build outputs ───
public/build
public/hot
public/storage

# ─── Storage & cache ───
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!storage/.gitkeep
!bootstrap/cache/.gitkeep

# ─── Database ───
database/*.sqlite
database/*.sqlite-*
database/*.db

# ─── Migration backups ───
backup_migrations/

# ─── IDE & editors ───
.idea
.vscode
.fleet
*.swp
*.swo
*~

