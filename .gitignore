.env
.env.*
!.env.example
.env.backup
.env.production
.env.staging
.env.local
.env.testing

# ───────────────────────────────────────────────────────────────
#  2. PHP / COMPOSER
# ───────────────────────────────────────────────────────────────
/vendor/
composer.phar
composer.lock.orig
*.phar

# Composer cache
/.composer/
.auth.json
auth.json

# ───────────────────────────────────────────────────────────────
#  3. NODE / NPM / YARN / PNPM
# ───────────────────────────────────────────────────────────────
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
.yarnrc.yml
pnp.*
*.tgz

# Vite cache
.vite/
node_modules/.vite/

# ───────────────────────────────────────────────────────────────
#  4. BUILD ARTIFACTS
# ───────────────────────────────────────────────────────────────
/public/build/
/public/hot
/public/storage
/public/vendor
/public/.well-known/

# Old mix artifacts
/public/mix-manifest.json
/public/js/*.js.map
/public/css/*.css.map

# ───────────────────────────────────────────────────────────────
#  5. LARAVEL STORAGE
# ───────────────────────────────────────────────────────────────
/storage/*.key
/storage/*.txt
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
!/storage/framework/cache/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/framework/cache/data/.gitkeep
!/storage/logs/.gitkeep
!/storage/app/.gitkeep
!/storage/app/public/.gitkeep

# SQLite database files (regenerable)
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal
/database/database.sqlite
/database/database.sqlite.*
/database/*.db
/database/*.db-journal

# Keep migration backup folder out of Git
/backup_migrations/
/backup_migrations/*

# ───────────────────────────────────────────────────────────────
#  6. BOOTSTRAP CACHE
# ───────────────────────────────────────────────────────────────
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

